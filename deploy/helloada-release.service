[Unit]
Description=HelloAda canonical Payload release queue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
UMask=0077
WorkingDirectory=/SOCIAL/payload-releases
ExecStart=/SOCIAL/site-agent/.venv/bin/python /SOCIAL/payload-releases/bin/current/dispatch-payload-releases.py
TimeoutStartSec=90min
KillMode=control-group
# API release promotion uses the host's existing non-interactive sudo policy.
# The trusted, serialized queue is the only caller; the mutable source checkout
# is never executed by this service.
NoNewPrivileges=false
PrivateTmp=true
StandardOutput=journal
StandardError=journal
