[Unit]
Description=HelloAda canonical Payload release queue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
UMask=0077
WorkingDirectory=/SOCIAL/payload-releases
ExecStart=/SOCIAL/site-agent/.venv/bin/python /SOCIAL/payload-releases/bin/current/dispatch-payload-releases.py
TimeoutStartSec=90min
KillMode=control-group
# Customer build scripts run as the deployment account, so privilege escalation
# remains disabled. The API release uses a fixed-function socket broker; it
# cannot choose arbitrary privileged commands or restart other services.
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
