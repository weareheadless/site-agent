{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "helloada-template",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": { "enabled": true }
  },
  "vars": {
    "SITE_AGENT_URL": "__SITE_AGENT_URL__",
    "NEXT_PUBLIC_SITE_URL": "__WORKER_URL__",
    "HELLOADA_TENANT_ID": "__TENANT_ID__",
    "HELLOADA_SITE_NAME": "__SITE_NAME__",
    "HELLOADA_HANDOFF_ISSUER": "https://helloada.app",
    "HELLOADA_HANDOFF_PUBLIC_KEY": "__HELLOADA_HANDOFF_PUBLIC_KEY__",
    "HELLOADA_TEMPLATE_SCHEMA": "8",
    "HELLOADA_WORKSPACE_API_VERSION": "v1",
    "HELLOADA_PAYLOAD_ADMIN_VERSION": "0.10.47",
    "HELLOADA_PAYLOAD_CORE_VERSION": "0.5.10",
    "HELLOADA_PAYLOAD_SCHEMA_REVISION": "9",
    "HELLOADA_CONTENT_CONTRACT_VERSION": "helloada-content-v4",
    "HELLOADA_SCHEMA_IDENTITY": "e13af32daa00ba2f90248d0d2a89101f2811f99cd165dad0a1f6f07a507afb0e",
    "HELLOADA_PAYLOAD_MIGRATION_HEAD": "806dedc866c1005b0004aea6446b1a0501e3482b7772be383368abb24d6f91ac",
    "HELLOADA_SITE_AGENT_VERSION": "__SITE_AGENT_VERSION__",
    "HELLOADA_MAILFLARE_INBOUND_QUEUE_NAME": "__MAILFLARE_INBOUND_QUEUE__",
    "HELLOADA_MAILFLARE_OUTBOUND_QUEUE_NAME": "__MAILFLARE_OUTBOUND_QUEUE__",
    "HELLOADA_MAILFLARE_AGENT_QUEUE_NAME": "__MAILFLARE_AGENT_QUEUE__"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "helloada-template"
    },
    {
      "binding": "MAILFLARE_DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "helloada-template-mail",
      "migrations_dir": ".mailflare/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "helloada-template-media" },
    { "binding": "PRIVATE_EMAIL", "bucket_name": "helloada-template-email", "preview_bucket_name": "helloada-template-email" },
    { "binding": "MAILFLARE_BUCKET", "bucket_name": "helloada-template-mail-files" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "HELLOADA_FORM_RATE_LIMIT", "namespace_id": "2701", "simple": { "limit": 10, "period": 60 } },
    { "name": "MAILFLARE_BOOKING_RATE_LIMIT", "namespace_id": "2703", "simple": { "limit": 5, "period": 60 } },
    { "name": "MAILFLARE_LOGIN_RATE_LIMIT", "namespace_id": "2704", "simple": { "limit": 20, "period": 60 } },
    { "name": "MAILFLARE_AGENT_RATE_LIMIT", "namespace_id": "2705", "simple": { "limit": 120, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "MAILFLARE_REALTIME", "class_name": "RealtimeHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }],
  "ai": { "binding": "MAILFLARE_AI" },
  "queues": {
    "producers": [
      { "binding": "MAILFLARE_INBOUND_QUEUE", "queue": "helloada-template-mail-inbound" },
      { "binding": "MAILFLARE_OUTBOUND_QUEUE", "queue": "helloada-template-mail-outbound" },
      { "binding": "MAILFLARE_AGENT_QUEUE", "queue": "helloada-template-mail-agent" }
    ],
    "consumers": [
      { "queue": "helloada-template-mail-inbound", "max_batch_size": 5, "max_retries": 3, "max_concurrency": 1 },
      { "queue": "helloada-template-mail-outbound", "max_batch_size": 5, "max_retries": 3, "max_concurrency": 1 },
      { "queue": "helloada-template-mail-agent", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 1 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *", "0 2 * * *"] }
}
