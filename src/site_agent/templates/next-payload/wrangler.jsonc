{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "helloada-template",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "SITE_AGENT_URL": "__SITE_AGENT_URL__",
    "NEXT_PUBLIC_SITE_URL": "__WORKER_URL__",
    "HELLOADA_TENANT_ID": "__TENANT_ID__",
    "HELLOADA_SITE_NAME": "__SITE_NAME__",
    "HELLOADA_HANDOFF_ISSUER": "https://helloada.app",
    "HELLOADA_HANDOFF_PUBLIC_KEY": "__HELLOADA_HANDOFF_PUBLIC_KEY__",
    "HELLOADA_TEMPLATE_SCHEMA": "7",
    "HELLOADA_WORKSPACE_API_VERSION": "v1",
    "HELLOADA_PAYLOAD_ADMIN_VERSION": "0.10.3",
    "HELLOADA_PAYLOAD_CORE_VERSION": "0.5.7",
    "HELLOADA_PAYLOAD_SCHEMA_REVISION": "7",
    "HELLOADA_CONTENT_CONTRACT_VERSION": "helloada-content-v3",
    "HELLOADA_SCHEMA_IDENTITY": "af92eb2228b2e8fdaeccfe578f684db9388f12f58e8ee23c72bfed4dee59a927",
    "HELLOADA_PAYLOAD_MIGRATION_HEAD": "db45bb7215e026ec272e45e6db82e344f3ebb615dd792ac65acc4e3295035918",
    "HELLOADA_SITE_AGENT_VERSION": "__SITE_AGENT_VERSION__"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "helloada-template"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "helloada-template-media" },
    { "binding": "PRIVATE_EMAIL", "bucket_name": "helloada-template-email", "preview_bucket_name": "helloada-template-email" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "HELLOADA_FORM_RATE_LIMIT", "namespace_id": "2701", "simple": { "limit": 10, "period": 60 } },
    { "name": "HELLOADA_NOTIFICATION_RATE_LIMIT", "namespace_id": "2702", "simple": { "limit": 5, "period": 60 } },
    { "name": "HELLOADA_BOOKING_RATE_LIMIT", "namespace_id": "2703", "simple": { "limit": 5, "period": 60 } }
  ],
  "queues": {
    "producers": [{ "binding": "HELLOADA_MESSAGES_QUEUE", "queue": "helloada-template-messages" }],
    "consumers": [
      { "queue": "helloada-template-messages", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 8, "retry_delay": 30, "max_concurrency": 1, "dead_letter_queue": "helloada-template-messages-dlq" },
      { "queue": "helloada-template-messages-dlq", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "retry_delay": 30, "max_concurrency": 1 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
