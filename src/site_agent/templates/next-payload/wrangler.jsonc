{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "helloada-template",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "SITE_AGENT_URL": "__SITE_AGENT_URL__",
    "NEXT_PUBLIC_SITE_URL": "__WORKER_URL__",
    "HELLOADA_TENANT_ID": "__TENANT_ID__",
    "HELLOADA_SITE_NAME": "__SITE_NAME__",
    "HELLOADA_TEMPLATE_SCHEMA": "4",
    "HELLOADA_WORKSPACE_API_VERSION": "v1",
    "HELLOADA_PAYLOAD_ADMIN_VERSION": "0.8.8",
    "HELLOADA_PAYLOAD_CORE_VERSION": "0.2.0",
    "HELLOADA_PAYLOAD_SCHEMA_REVISION": "2",
    "HELLOADA_CONTENT_CONTRACT_VERSION": "helloada-content-v2",
    "HELLOADA_SCHEMA_IDENTITY": "88efb2c6d810331060abdd4b85f4e19ee6b4ed913c91a8d363e8bfd996b02490",
    "HELLOADA_PAYLOAD_MIGRATION_HEAD": "3bf69131ddad68b8d90a382f7635d3b7b483d9600322e80be12731c481e63286",
    "HELLOADA_SITE_AGENT_VERSION": "__SITE_AGENT_VERSION__"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "helloada-template"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "helloada-template-media" }
  ]
}
