{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "helloada-template",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "SITE_AGENT_URL": "__SITE_AGENT_URL__",
    "NEXT_PUBLIC_SITE_URL": "__WORKER_URL__",
    "HELLOADA_TENANT_ID": "__TENANT_ID__",
    "HELLOADA_SITE_NAME": "__SITE_NAME__",
    "HELLOADA_TEMPLATE_SCHEMA": "5",
    "HELLOADA_WORKSPACE_API_VERSION": "v1",
    "HELLOADA_PAYLOAD_ADMIN_VERSION": "0.9.0",
    "HELLOADA_PAYLOAD_CORE_VERSION": "0.3.0",
    "HELLOADA_PAYLOAD_SCHEMA_REVISION": "3",
    "HELLOADA_CONTENT_CONTRACT_VERSION": "helloada-content-v3",
    "HELLOADA_MESSAGES_QUEUE_NAME": "helloada-template-messages",
    "HELLOADA_MESSAGES_DLQ_NAME": "helloada-template-messages-dlq",
    "HELLOADA_SCHEMA_IDENTITY": "a639f89df844075bcd230729b7ca603fdacafeffcdee0816f3b3e61df6394679",
    "HELLOADA_PAYLOAD_MIGRATION_HEAD": "f87debcf7d1638fd9d92a8afe5ba5847d4eccb8775fdaa1e380591a26cabd9b4",
    "HELLOADA_TURNSTILE_SITE_KEY": "__HELLOADA_TURNSTILE_SITE_KEY__",
    "HELLOADA_SITE_AGENT_VERSION": "__SITE_AGENT_VERSION__"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "helloada-template"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "helloada-template-media" },
    { "binding": "PRIVATE_EMAIL", "bucket_name": "helloada-template-email", "preview_bucket_name": "helloada-template-email" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "HELLOADA_FORM_RATE_LIMIT", "namespace_id": "2701", "simple": { "limit": 10, "period": 60 } }],
  "queues": {
    "producers": [{ "binding": "HELLOADA_MESSAGES_QUEUE", "queue": "helloada-template-messages" }],
    "consumers": [
      { "queue": "helloada-template-messages", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 8, "retry_delay": 30, "max_concurrency": 1, "dead_letter_queue": "helloada-template-messages-dlq" },
      { "queue": "helloada-template-messages-dlq", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "retry_delay": 30, "max_concurrency": 1 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
