{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "helloada-template",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "SITE_AGENT_URL": "__SITE_AGENT_URL__",
    "NEXT_PUBLIC_SITE_URL": "__WORKER_URL__",
    "HELLOADA_TENANT_ID": "__TENANT_ID__",
    "HELLOADA_SITE_NAME": "__SITE_NAME__",
    "HELLOADA_HANDOFF_ISSUER": "https://helloada.app",
    "HELLOADA_HANDOFF_PUBLIC_KEY": "__HELLOADA_HANDOFF_PUBLIC_KEY__",
    "HELLOADA_TEMPLATE_SCHEMA": "6",
    "HELLOADA_WORKSPACE_API_VERSION": "v1",
    "HELLOADA_PAYLOAD_ADMIN_VERSION": "0.10.1",
    "HELLOADA_PAYLOAD_CORE_VERSION": "0.5.2",
    "HELLOADA_PAYLOAD_SCHEMA_REVISION": "5",
    "HELLOADA_CONTENT_CONTRACT_VERSION": "helloada-content-v3",
    "HELLOADA_SCHEMA_IDENTITY": "89ee058005fe2aa951d9c21b625d1f366919cb0a9071658f4a82241f91364532",
    "HELLOADA_PAYLOAD_MIGRATION_HEAD": "75064eaeb5a035afc8977d39a59742dfa8bfb5e94d344ca9090e29e516bb2534",
    "HELLOADA_SITE_AGENT_VERSION": "__SITE_AGENT_VERSION__"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "helloada-template"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "helloada-template-media" }
  ]
}
