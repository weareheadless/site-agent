{
  "name": "helloada-site-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts PAYLOAD_CLI=1 payload generate:importmap && npm run generate:types",
    "build": "cross-env PAYLOAD_LOCAL_BUILD=1 next build --webpack",
    "dev": "next dev",
    "lint": "eslint src",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts PAYLOAD_CLI=1 payload",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:payload": "cross-env NODE_ENV=production PAYLOAD_CLI=1 PAYLOAD_SECRET=ignore node --import tsx scripts/verify-payload-contract.ts",
    "generate:importmap": "npm run payload -- generate:importmap",
    "generate:types": "npm run payload -- generate:types",
    "pretypecheck": "npm run generate:types"
  },
  "dependencies": {
    "@weareheadless/helloada-payload-admin": "https://github.com/weareheadless/site-agent/releases/download/payload-admin-v0.10.21/weareheadless-helloada-payload-admin-0.10.21.tgz",
    "@weareheadless/helloada-payload-core": "https://github.com/weareheadless/site-agent/releases/download/helloada-payload-core-v0.5.9/weareheadless-helloada-payload-core-0.5.9.tgz",
    "@opennextjs/cloudflare": "1.20.6",
    "@payloadcms/db-d1-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-r2": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cli-color": "2.0.4",
    "cross-env": "7.0.3",
    "graphql": "16.14.2",
    "next": "16.3.4",
    "payload": "3.88.0",
    "postal-mime": "3.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.16.0",
    "eslint-config-next": "16.3.4",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "wrangler": "4.134.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  }
}
