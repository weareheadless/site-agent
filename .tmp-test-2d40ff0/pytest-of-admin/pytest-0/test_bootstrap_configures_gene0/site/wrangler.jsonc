{
  "vars": {
    "SITE_AGENT_URL": "https://api.helloada.app/v1",
    "NEXT_PUBLIC_SITE_URL": "https://helloada-demo.workers.dev",
    "HELLOADA_SITE_NAME": "Demo",
    "HELLOADA_TENANT_ID": "demo",
    "HELLOADA_SITE_AGENT_VERSION": "0.1.1",
    "HELLOADA_TEMPLATE_SCHEMA": "4",
    "HELLOADA_PAYLOAD_ADMIN_VERSION": "0.8.6",
    "HELLOADA_PAYLOAD_CORE_VERSION": "0.1.0",
    "HELLOADA_CONTENT_CONTRACT_VERSION": "helloada-content-v1"
  },
  "name": "helloada-demo",
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "",
      "database_name": "helloada-demo"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "helloada-demo-media"
    }
  ]
}
